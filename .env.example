AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=groq/compound
GROQ_VISION_MODEL=qwen/qwen3.6-27b
CONSENSUS_ENABLED=1
CONSENSUS_ENGINES=openai,claude,gemini
APP_USERNAME=user
APP_PASSWORD=
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_MAX_IDENTITIES=4096
# Set TRUST_PROXY=1 when one reverse proxy overwrites/appends X-Forwarded-For.
# Use a higher integer when multiple trusted proxies are in front of the app.
TRUST_PROXY=0
OANDA_API_TOKEN=
OANDA_ENVIRONMENT=practice
TWELVEDATA_API_KEY=
MARKET_FALLBACK_ENABLED=1
MARKET_RESEARCH_ENABLED=1
FORECAST_LOG_ENABLED=1
FORECAST_DB_PATH=data/forecasts.db
FORECAST_HORIZON_HOURS=48
FORECAST_DB_DURABLE=0
