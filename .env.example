# Frontend: use a proxy in deployed environments so provider keys stay private.
VITE_GROQ_PROXY_URL=https://your-proxy.example.com
VITE_PROXY_ACCESS_KEY=
# Optional override; proxy mode defaults to a larger budget.
VITE_GROQ_TPM_LIMIT=

# Direct Groq mode remains available for local development only.
VITE_GROQ_API_KEY=

# Proxy/server environment. At least one provider key is required.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional third provider/fallback:
GROQ_API_KEY=
PROXY_ACCESS_KEY=
ALLOWED_ORIGINS=http://localhost:5173

ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_VISION_MODEL=gpt-4o
OPENAI_TEXT_MODEL=gpt-4o-mini
AI_VISION_PROVIDERS=openai,anthropic,groq
AI_TEXT_PROVIDERS=anthropic,openai,groq
