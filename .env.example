# Public deployments should use a server-side proxy so provider keys stay private.
VITE_GROQ_PROXY_URL=https://your-proxy.example.com
# Optional shared password gate for public deployments; this is only a deterrent.
VITE_APP_PASSWORD=

# Proxy/server environment:
# GROQ_API_KEY=your_groq_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# Use OpenAI as the primary provider to bypass Groq capacity pressure:
# AI_PRIMARY_PROVIDER=openai
