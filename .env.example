AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GROQ_API_KEY=
GROQ_MODEL=groq/compound
GROQ_VISION_MODEL=qwen/qwen3.6-27b
APP_USERNAME=user
APP_PASSWORD=
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_MAX_IDENTITIES=4096
# Set TRUST_PROXY=1 when one reverse proxy overwrites/appends X-Forwarded-For.
# Use a higher integer when multiple trusted proxies are in front of the app.
TRUST_PROXY=0
